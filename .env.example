# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rawafri?schema=public"

# App
PORT=3000
NODE_ENV=development

# JWT (generate strong random strings for production)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_RESET_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP (used by MailModule for OTP/password-reset emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM=no-reply@rawafri.com

# Cloudflare R2 (S3-compatible object storage — payment proof uploads, and
# eventually product images. Files must NOT be stored on local disk in
# production since most hosts wipe the filesystem on every redeploy.)
# 1. Create a bucket at https://dash.cloudflare.com -> R2
# 2. Create an API token (R2 -> Manage API Tokens) with read+write access
# 3. Enable public access on the bucket (or attach a custom domain) to get R2_PUBLIC_URL
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=rawafri-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev